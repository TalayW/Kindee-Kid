"use strict";

const test = require("node:test");
const assert = require("node:assert/strict");
const handler = require("../api/analyze-food.js");

function tinyImage() {
  return "data:image/jpeg;base64,/9j/2Q==";
}

function makeReq({ method = "POST", body = {}, ip = "127.0.0.1" } = {}) {
  return {
    method,
    body,
    headers: {
      host: "localhost:3000",
      origin: "http://localhost:3000",
      "x-forwarded-proto": "http",
      "x-forwarded-for": ip
    },
    socket: { remoteAddress: ip }
  };
}

function makeRes() {
  return {
    statusCode: 200,
    headers: {},
    body: "",
    setHeader(key, value) { this.headers[key.toLowerCase()] = value; },
    end(value = "") { this.body = value; }
  };
}

test("rejects invalid image", async () => {
  const req = makeReq({ body: { image: "not-an-image" }, ip: "10.0.0.1" });
  const res = makeRes();
  await handler(req, res);
  assert.equal(res.statusCode, 400);
  assert.match(JSON.parse(res.body).error, /รูปภาพไม่ถูกต้อง/);
});

test("returns normalized structured analysis", async () => {
  const originalFetch = global.fetch;
  const originalKey = process.env.OPENAI_API_KEY;
  process.env.OPENAI_API_KEY = "test-key";

  const modelPayload = {
    is_food: true,
    meal_name_th: "ข้าว ไข่เจียว และแตงกวา",
    visible_items: [
      { name_th: "ข้าวสวย", group: "starch", portion: 1.2, confidence: "high" },
      { name_th: "ไข่เจียว", group: "protein", portion: 1.1, confidence: "medium" },
      { name_th: "แตงกวา", group: "veg", portion: 0.4, confidence: "high" }
    ],
    groups: { veg: 0.4, starch: 1.2, protein: 1.1, fruit: 0, dairy: 0 },
    flags: { sweet_drink: false, fried: true, sweet_snack: false },
    overall_confidence: "medium",
    uncertainties: ["ไม่ทราบปริมาณน้ำมันในไข่เจียว"],
    child_message_th: "AI ช่วยเสนอแล้ว ลองตรวจให้ตรงกับจานจริงนะ"
  };

  global.fetch = async (_url, options) => {
    const request = JSON.parse(options.body);
    assert.equal(request.store, false);
    assert.equal(request.input[0].content[1].type, "input_image");
    assert.equal(request.text.format.type, "json_schema");
    return {
      ok: true,
      status: 200,
      async json() {
        return {
          output: [
            {
              type: "message",
              content: [{ type: "output_text", text: JSON.stringify(modelPayload) }]
            }
          ]
        };
      }
    };
  };

  try {
    const req = makeReq({ body: { image: tinyImage(), mealType: "lunch" }, ip: "10.0.0.2" });
    const res = makeRes();
    await handler(req, res);
    assert.equal(res.statusCode, 200);
    const data = JSON.parse(res.body);
    assert.equal(data.analysis.meal_name_th, "ข้าว ไข่เจียว และแตงกวา");
    assert.equal(data.analysis.groups.starch, 1);
    assert.equal(data.analysis.groups.protein, 1);
    assert.equal(data.analysis.groups.veg, 0.5);
    assert.equal(data.analysis.flags.fried, true);
    assert.equal(data.analysis._meta.storageRequested, false);
  } finally {
    global.fetch = originalFetch;
    if (originalKey === undefined) delete process.env.OPENAI_API_KEY;
    else process.env.OPENAI_API_KEY = originalKey;
  }
});

test("returns configuration error when API key is absent", async () => {
  const originalKey = process.env.OPENAI_API_KEY;
  delete process.env.OPENAI_API_KEY;
  try {
    const req = makeReq({ body: { image: tinyImage() }, ip: "10.0.0.3" });
    const res = makeRes();
    await handler(req, res);
    assert.equal(res.statusCode, 503);
    assert.match(JSON.parse(res.body).error, /OPENAI_API_KEY/);
  } finally {
    if (originalKey !== undefined) process.env.OPENAI_API_KEY = originalKey;
  }
});
